# Copy this file to .env in the repo root and fill in only what you need:
#   cp .env.example .env
# .env is gitignored, so your keys are never committed.
# Variables already exported in your shell take priority over this file.
#
# The mock and kokoro voices need nothing from this file.

# Gemini TTS (--provider gemini).
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# ElevenLabs TTS (--provider elevenlabs).
# Create a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Optional. Path to a local Chrome or Chromium for rendering, used when
# Remotion cannot download its own headless browser. Same as passing
# --browser-executable to `pnpm video render`. Leave commented out to let
# Remotion manage the browser.
# REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
